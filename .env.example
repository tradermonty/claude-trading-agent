# --- Required ---
ANTHROPIC_API_KEY=

# --- External API Keys ---
FMP_API_KEY=

# --- Model ---
CLAUDE_MODEL=claude-sonnet-4-6

# --- Managed Agents: set these to reuse existing resources ---
# If left empty, new agent/environment are created on first request.
MANAGED_AGENT_ID=
MANAGED_ENVIRONMENT_ID=

# --- Agent defaults (used when creating new agent) ---
MANAGED_AGENT_NAME=Trade Assistant
MANAGED_ENVIRONMENT_NAME=chat-app-env

# --- Skill IDs ---
SCENARIO_ANALYZER_SKILL_ID=
FTD_DETECTOR_SKILL_ID=
VCP_SCREENER_SKILL_ID=
MACRO_REGIME_DETECTOR_SKILL_ID=
CANSLIM_SCREENER_SKILL_ID=
THEME_DETECTOR_SKILL_ID=
MARKET_BREADTH_ANALYZER_SKILL_ID=
EARNINGS_CALENDAR_SKILL_ID=
ECONOMIC_CALENDAR_SKILL_ID=
BREAKOUT_TRADE_PLANNER_SKILL_ID=
IBD_DISTRIBUTION_DAY_MONITOR_SKILL_ID=

# --- App settings ---
APP_TITLE=Trade Assistant
APP_LOCALE=en
APP_LOG_FORMAT=text
APP_LOG_LEVEL=INFO
REQUESTS_PER_MINUTE_LIMIT=20

# --- Skill behavior overrides (optional) ---
# LEGACY_SKILL_SESSION=1 forces the pre-Phase-1 path: each skill invocation
# creates a fresh skill-specific Agent + Session. Set this only to roll back
# from the default (session-reuse) path if you observe regressions.
# Accepted truthy values: 1, true, yes (case-insensitive).
# LEGACY_SKILL_SESSION=
#
# SKILLS_REFS_DISABLED is a comma-separated list of skill names whose
# reference_context injection should be suppressed. Used by the Phase 2
# A/B harness (scripts/eval_skill_refs.py) to measure whether Managed
# Skills auto-load alone is sufficient. Whitespace-tolerant.
# Example: SKILLS_REFS_DISABLED=market-breadth-analyzer
# SKILLS_REFS_DISABLED=
